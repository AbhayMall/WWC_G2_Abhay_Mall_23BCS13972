/*
Home Task - 1

Create a Java program that models a simple banking system using OOP. 
Define a BankAccount class with private fields for account number, account holder name, and balance, along with methods to deposit, withdraw, and print account details.
Then create a subclass SavingsAccount that adds an interest rate and overrides the withdraw() method to prevent withdrawing more than the available balance. 
In your Main class, create objects of both classes, perform deposits and withdrawals, apply interest to the savings account, and display the final account details.
*/

class InvalidTransaction extends Exception{
    InvalidTransaction(String msg){
        super(msg);
    }
}

class Account{
    public int balance;
    private double accountNumber;
    private String accountHolderName;

    Account(int balance, double accountNumber, String accountHolderName){
        this.balance = balance;
        this.accountNumber = accountNumber;
        this.accountHolderName = accountHolderName;
    }
    public void getInfo(){
        System.out.println("Account Number: "+ accountNumber +
                "\nAccount Holder Name: "+ accountHolderName
                + "\nBalance: "+ balance);
    }
    public void withdraw(int amount) throws InvalidTransaction{
        if(amount>balance){
            throw new InvalidTransaction("Insufficient Balance");
        }
        else{
            balance -= amount;
        }
    }
    public void deposit(int amt) {
        balance += amt;
    }
}

class SavingsAccount extends Account{
    long interestRate;
    SavingsAccount(int balance, double accountNumber, String accountHolderName, long interestRate){
        super(balance, accountNumber, accountHolderName);
        this.interestRate = interestRate;
    }
    @Override
    public void withdraw(int amount) throws InvalidTransaction{
        if(amount>balance){
            throw new InvalidTransaction("Insufficient Balance");
        }
        else{
            balance -= amount;
        }
    }

    public void updateBalance(int time){
        balance = (int) ((balance * time * interestRate)/100) + balance;
    }
}

public class Bank {
    public static void main(String[] args) {
        SavingsAccount ac = new SavingsAccount(1000,10889,"Himanshu Gupta", 10);
        ac.deposit(100);
        try{
            ac.withdraw(500);
            ac.getInfo();
            System.out.println("INAVLID DOING");
            ac.withdraw(2000); // error thrown here
            ac.withdraw(500);
        }catch (InvalidTransaction t){
            System.out.println(t.getMessage());
        }finally {
            ac.getInfo();
            System.out.println("APPYLUING INTEREST FOR 2 YEARS At 10%");
            ac.updateBalance(2);
            ac.getInfo();
        }
    }
}
